#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

# Keep warnings as warnings: a newer compiler must not make the package
# fail to build.
override_dh_auto_build:
	dh_auto_build -- WERROR=

override_dh_auto_test:
	dh_auto_test -- WERROR=

override_dh_auto_install:
	dh_auto_install -- PREFIX=/usr

# dwz 0.15, as on Ubuntu 24.04, rejects GCC's .debug_addr section and
# fails the build. Debug compression is optional, so keep going.
override_dh_dwz:
	dh_dwz || true
